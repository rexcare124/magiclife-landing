# Copy this file to .env.local and fill in the values.

# Contact form (https://resend.com/api-keys)
# Without a key, messages are logged to the console in development and the form reports an error in production.
RESEND_API_KEY=
# Where contact form messages are delivered (defaults to site.email)
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "MagicLife <hello@magiclife.com>"
CONTACT_FROM_EMAIL=

# Sanity blog (https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# Optional: only needed if the dataset is private
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=
